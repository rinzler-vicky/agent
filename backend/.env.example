# Server
PORT=3000
NODE_ENV=development

# Postgres (Neon or local)
DATABASE_URL=postgresql://user:password@localhost:5432/agent_db
DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true  # Set to 'false' only for Neon/Supabase pooler endpoints
DB_POOL_MAX=10

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=1h

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3001

# AWS S3 / Object Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=agent-artifacts
# S3_ENDPOINT=http://localhost:9000  # Uncomment for MinIO/local S3

# Redis (for n8n queue mode)
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=  # Optional Redis password

# n8n Integration
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=
N8N_ENCRYPTION_KEY=change-me-in-production-min-32-chars

# n8n adapter (Phase 2.3): callback URL n8n uses to POST execution events
# back to the backend; HMAC-style shared secret for verification.
N8N_WEBHOOK_BASE_URL=http://backend:3000
N8N_WEBHOOK_SECRET=change-me-in-production-min-32-chars
N8N_WEBHOOK_CLOCK_SKEW_S=300
N8N_RECONCILE_TIMEOUT_MS=2000

# n8n execution adapter (Phase 2.5a): timeout for POST /workflows/:id/run,
# and the delay before falling back to GET /executions when the run response
# arrives without an executionId.
N8N_TRIGGER_TIMEOUT_MS=10000
N8N_TRIGGER_LIST_FALLBACK_DELAY_MS=500

# SSE event stream (Phase 2.5a): heartbeat interval that keeps reverse-proxy
# connections alive during long-running workflows.
SSE_HEARTBEAT_MS=15000

# Neon API (for preview environment provisioning)
NEON_API_KEY=
NEON_PROJECT_ID=

# Phase 2.5b — agent-initiated previews. Disabled by default; set to 'true'
# only after Render + Neon API credentials are provisioned and the per-tenant
# concurrency cap is sized for your plan.
AGENT_PREVIEW_ENABLED=false
MAX_ACTIVE_AGENT_PREVIEWS_PER_TENANT=3
AGENT_PREVIEW_TTL_HOURS=24

# Render API — required when AGENT_PREVIEW_ENABLED=true. RENDER_OWNER_ID is
# the workspace owner ID under which preview services are created.
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_REPO_URL=https://github.com/rinzler-vicky/agent
RENDER_BASE_BRANCH=main
