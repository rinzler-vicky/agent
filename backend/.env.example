# Server
PORT=3000
NODE_ENV=development

# Postgres (Neon or local)
DATABASE_URL=postgresql://user:password@localhost:5432/agent_db
DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true  # Set to 'false' only for Neon/Supabase pooler endpoints
DB_POOL_MAX=10

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=1h

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3001

# AWS S3 / Object Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=agent-artifacts
# S3_ENDPOINT=http://localhost:9000  # Uncomment for MinIO/local S3
